{
  "meta": {
    "units": "points (CSS px = pt)",
    "oklch": "OKLab→linear sRGB (Björn Ottosson matrices), gamma-encode; srgb values are precomputed and clamped.",
    "source": "gate.css"
  },
  "color": {
    "primitive": {
      "steel-0": {
        "oklch": "oklch(0 0 0)",
        "srgb": "#000000"
      },
      "steel-1": {
        "oklch": "oklch(0.13 0.003 265)",
        "srgb": "#070708"
      },
      "steel-2": {
        "oklch": "oklch(0.165 0.004 265)",
        "srgb": "#0d0e10"
      },
      "steel-3": {
        "oklch": "oklch(0.2 0.005 265)",
        "srgb": "#151618"
      },
      "steel-4": {
        "oklch": "oklch(0.245 0.006 265)",
        "srgb": "#1f2023"
      },
      "steel-5": {
        "oklch": "oklch(0.295 0.007 265)",
        "srgb": "#2b2d30"
      },
      "steel-6": {
        "oklch": "oklch(0.43 0.008 265)",
        "srgb": "#4e5054"
      },
      "steel-7": {
        "oklch": "oklch(0.58 0.008 265)",
        "srgb": "#787a7f"
      },
      "steel-8": {
        "oklch": "oklch(0.76 0.006 265)",
        "srgb": "#afb1b5"
      },
      "steel-9": {
        "oklch": "oklch(0.96 0.003 265)",
        "srgb": "#f1f2f4"
      },
      "amber-5": {
        "oklch": "oklch(0.82 0.13 72)",
        "srgb": "#f8b65d"
      },
      "amber-ink": {
        "oklch": "oklch(0.26 0.06 60)",
        "srgb": "#381c01"
      },
      "prism-1": {
        "oklch": "oklch(0.82 0.12 200)",
        "srgb": "#4cdbe3"
      },
      "prism-2": {
        "oklch": "oklch(0.7 0.16 268)",
        "srgb": "#7498ff"
      },
      "prism-3": {
        "oklch": "oklch(0.72 0.2 330)",
        "srgb": "#e76edf"
      },
      "prism-4": {
        "oklch": "oklch(0.84 0.13 62)",
        "srgb": "#ffb66d"
      },
      "ion-5": {
        "oklch": "oklch(0.78 0.11 250)",
        "srgb": "#80bdfb"
      },
      "green-5": {
        "oklch": "oklch(0.79 0.13 155)",
        "srgb": "#6fd395"
      },
      "red-5": {
        "oklch": "oklch(0.7 0.17 25)",
        "srgb": "#f66d67"
      }
    },
    "semantic": {
      "canvas": {
        "ref": "steel-0",
        "use": "Behind picture. Screening, viewers."
      },
      "sunken": {
        "ref": "steel-1",
        "use": "Inputs, wells."
      },
      "ground": {
        "ref": "steel-2",
        "use": "Window background, sheets, sidebars."
      },
      "panel": {
        "ref": "steel-3",
        "use": "Cards, selected rows, popovers."
      },
      "raised": {
        "ref": "steel-4",
        "use": "Buttons, chips, selected segment."
      },
      "hover": {
        "ref": "steel-5",
        "use": "Hover fill, switch track off."
      },
      "line": {
        "oklch": "oklch(1 0 0 / 0.08)",
        "srgb": "#ffffff14",
        "use": "Hairlines and dividers."
      },
      "line-2": {
        "oklch": "oklch(1 0 0 / 0.15)",
        "srgb": "#ffffff26",
        "use": "Control borders, focus-adjacent."
      },
      "text-1": {
        "ref": "steel-9",
        "use": "Primary text."
      },
      "text-2": {
        "ref": "steel-8",
        "use": "Secondary text."
      },
      "text-3": {
        "ref": "steel-7",
        "use": "Tertiary, captions."
      },
      "text-4": {
        "ref": "steel-6",
        "use": "Disabled, separators, placeholder."
      },
      "director": {
        "ref": "amber-5",
        "use": "Director's acts only: marks, notes numbers, circles, ranges, regions."
      },
      "director-wash": {
        "oklch": "oklch(0.82 0.13 72 / 0.15)",
        "srgb": "#f8b65d26",
        "use": "Director chip/range fill."
      },
      "director-ink": {
        "ref": "amber-ink",
        "use": "Text on amber."
      },
      "agent": {
        "ref": "ion-5",
        "use": "Editor text and solid diamonds."
      },
      "agent-wash": {
        "oklch": "oklch(0.78 0.11 250 / 0.13)",
        "srgb": "#80bdfb21",
        "use": "Editor chip fill."
      },
      "prism": {
        "gradient": {
          "angle": 100,
          "stops": [
            [
              "prism-1",
              0
            ],
            [
              "prism-2",
              0.34
            ],
            [
              "prism-3",
              0.66
            ],
            [
              "prism-4",
              1
            ]
          ]
        },
        "use": "Editor hairlines ≤2pt, diamonds, shimmer, sweep. Never fills."
      },
      "locked": {
        "ref": "steel-9",
        "use": "Lock icon; hatching is white 8% 1pt lines at 135°, 6pt pitch."
      },
      "approve": {
        "ref": "green-5",
        "use": "Accepted, delivered."
      },
      "approve-wash": {
        "oklch": "oklch(0.79 0.13 155 / 0.13)",
        "srgb": "#6fd39521",
        "use": ""
      },
      "alert": {
        "ref": "red-5",
        "use": "Errors, can't-do, offline."
      },
      "alert-wash": {
        "oklch": "oklch(0.7 0.17 25 / 0.13)",
        "srgb": "#f66d6721",
        "use": ""
      },
      "scrim": {
        "oklch": "oklch(0 0 0 / 0.55)",
        "srgb": "#0000008c",
        "use": "Behind sheets."
      },
      "glass": {
        "fill": "oklch(0.2 0.005 265 / 0.55)",
        "blur": 18,
        "saturate": 1.4,
        "border": "white 14%",
        "innerTopHighlight": "white 12%",
        "use": "Floating over picture only. SwiftUI: .ultraThinMaterial + steel-3 55% tint."
      }
    }
  },
  "type": {
    "families": {
      "ui": "SF Pro (system)",
      "mono": "SF Mono (system, monospacedDigit)",
      "brand": "Archivo Variable, bundled; width axis 112–125, weight 700–800"
    },
    "styles": {
      "brand-xl": {
        "family": "brand",
        "size": 34,
        "weight": 800,
        "width": 125,
        "tracking": -0.02,
        "lineHeight": 1.0,
        "use": "Empty-state and welcome titles"
      },
      "brand-l": {
        "family": "brand",
        "size": 24,
        "weight": 800,
        "width": 120,
        "tracking": -0.01,
        "lineHeight": 1.05,
        "use": "Sheet and room titles"
      },
      "brand-m": {
        "family": "brand",
        "size": 17,
        "weight": 700,
        "width": 112,
        "lineHeight": 1.1,
        "use": "Panel headings: Notes on Cut 3"
      },
      "brand-s": {
        "family": "brand",
        "size": 14,
        "weight": 700,
        "width": 112,
        "use": "Option labels, cut names in lists"
      },
      "title": {
        "family": "ui",
        "size": 15,
        "weight": 600
      },
      "body": {
        "family": "ui",
        "size": 13,
        "weight": 400,
        "lineHeight": 1.45
      },
      "control": {
        "family": "ui",
        "size": 12.5,
        "weight": 500
      },
      "small": {
        "family": "ui",
        "size": 12,
        "weight": 400,
        "color": "text-3"
      },
      "caption": {
        "family": "ui",
        "size": 11,
        "weight": 400,
        "color": "text-3"
      },
      "label": {
        "family": "mono",
        "size": 10.5,
        "weight": 500,
        "tracking": 0.07,
        "case": "upper",
        "color": "text-4"
      },
      "timecode": {
        "family": "mono",
        "size": 12,
        "weight": 500,
        "tabular": true
      },
      "note-number": {
        "family": "mono",
        "size": 14,
        "weight": 600,
        "color": "director"
      }
    }
  },
  "space": {
    "base": 4,
    "scale": [
      2,
      4,
      6,
      8,
      10,
      12,
      14,
      16,
      20,
      24,
      28,
      32,
      40,
      48,
      64
    ]
  },
  "radius": {
    "window": 16,
    "panel": 12,
    "card": 10,
    "control": 8,
    "chip": 6,
    "frame": 2,
    "rule": "Concentric: inner = outer − padding."
  },
  "size": {
    "titlebar": 52,
    "sidebar": 240,
    "notesSheet": 380,
    "control": 28,
    "controlLarge": 36,
    "controlSmall": 22,
    "chip": 20,
    "pill": 28,
    "strip": {
      "height": 44,
      "scene": 24,
      "tall": 64,
      "tallScene": 40,
      "gap": 2
    },
    "windowMin": [
      1180,
      740
    ],
    "windowDesign": [
      1440,
      900
    ],
    "settingsWidth": 720
  },
  "motion": {
    "easing": {
      "out": [
        0.2,
        0.8,
        0.2,
        1
      ],
      "inOut": [
        0.6,
        0,
        0.2,
        1
      ]
    },
    "duration": {
      "snap": 120,
      "settle": 220,
      "glide": 360,
      "sweep": 900,
      "shimmer": 2400
    },
    "use": {
      "snap": "hover, press, toggles",
      "settle": "marks dropping, rows inserting, popovers",
      "glide": "room changes, sheets",
      "sweep": "once when a cut arrives",
      "shimmer": "loop on editor pill/borders while working"
    },
    "rules": [
      "Nothing moves during playback except playhead and time.",
      "Reduce Motion: no shimmer (static prism), sweep becomes 220ms fade, slides become fades."
    ]
  },
  "elevation": {
    "popover": "0 0 0 1px line-2; 0 24 60 -12 black 90%",
    "toast": "0 0 0 1px white 12%; inset 0 1 0 white 10%; 0 20 40 -12 black 80%",
    "sheet": "0 0 0 1px line-2; 0 30 80 -10 black 90%"
  },
  "grain": {
    "tile": 180,
    "opacity": 0.035,
    "blend": "screen",
    "noise": "fractal, baseFrequency 0.85, 2 octaves",
    "rule": "Over window chrome, never over the picture."
  },
  "component": {
    "button": {
      "height": 28,
      "paddingX": 11,
      "radius": 8,
      "fill": "raised",
      "border": "inset line",
      "topHighlight": "white 6%",
      "hover": "hover",
      "press": "panel, y+0.5"
    },
    "button.steel": {
      "text": "#1f2024 (oklch .17)",
      "gradient": [
        "oklch(.98 .002 265)",
        "oklch(.80 .006 265) @92%"
      ],
      "hover": [
        "white",
        "oklch(.86 .006 265)"
      ],
      "press": "reversed",
      "weight": 600,
      "rule": "One per window state."
    },
    "chip": {
      "height": 20,
      "paddingX": 7,
      "radius": 6,
      "font": "mono 11/500"
    },
    "editorPill": {
      "height": 28,
      "radius": 14,
      "paddingX": [
        10,
        11
      ],
      "states": [
        "ready",
        "readingBack",
        "working(shimmer)",
        "asks",
        "blocked",
        "offline"
      ]
    },
    "noteRow": {
      "numberColumn": 26,
      "paddingY": 12,
      "paddingX": [
        14,
        16
      ],
      "selectedBar": 2
    },
    "sceneStrip": {
      "sceneHeight": 24,
      "gap": 2,
      "radius": 3,
      "changedEdge": "prism 2pt top",
      "locked": "grayscale 30% + hatching",
      "playhead": "2pt text-1 with 10×5 cap"
    }
  }
}