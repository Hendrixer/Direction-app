#!/bin/bash
# A stand-in for `claude -p … --output-format stream-json --verbose` (EditorRunnerTests).
# It runs in the film's Editor folder, records its arguments there, and prints canned events
# for the scenario in .fake-scenario: done, unfinished, auth, slow, crash, readback, readback-script.
folder="$PWD"
printf '%s\n' "$@" > "$folder/.fake-args"
printf '%s\n' "${DIRECTION_RUN_ID:-}" > "$folder/.fake-run-id"
scenario="$(cat "$folder/.fake-scenario" 2>/dev/null || echo done)"
session="fake-session-1"
echo '{"type":"system","subtype":"init","session_id":"'"$session"'","tools":[],"mcp_servers":[{"name":"direction","status":"connected"}]}'
read_notes() {
  echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Reading my notes."},{"type":"tool_use","id":"toolu_1","name":"Read","input":{"file_path":"'"$folder"'/NOTES.md"}}]},"session_id":"'"$session"'"}'
  echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_1","content":[{"type":"text","text":"# Notes between runs"}]}]},"session_id":"'"$session"'"}'
}
case "$scenario" in
  done|unfinished)
    read_notes
    echo '{"type":"result","subtype":"success","is_error":false,"result":"Done.\n{\"finished\": true, \"summary\": \"Logged 1 take.\", \"needsYou\": []}","total_cost_usd":0.42,"session_id":"'"$session"'"}'
    ;;
  auth)
    echo '{"type":"result","subtype":"success","is_error":true,"result":"Invalid API key · Please run /login","total_cost_usd":0,"session_id":"'"$session"'"}'
    exit 1
    ;;
  slow)
    read_notes
    trap 'kill $sleeper 2>/dev/null; exit 130' INT TERM
    sleep 30 & sleeper=$!
    wait $sleeper
    ;;
  crash)
    echo "fake-claude: the program fell over at frame 214" >&2
    exit 3
    ;;
  straggler)
    # Leaves a job behind that outlives it, like an agent's `ffmpeg … &`, then finishes.
    read_notes
    (sleep 300 </dev/null >/dev/null 2>&1 & echo $! > "$folder/.fake-straggler")
    echo '{"type":"result","subtype":"success","is_error":false,"result":"{\"finished\": true, \"summary\": \"Logged 1 take.\", \"needsYou\": []}","total_cost_usd":0.1,"session_id":"'"$session"'"}'
    ;;
  readback)
    # Posts a read-back, says so in .fake-asked and waits for .fake-go before its turn ends, so the
    # test can play Direction's side of the call and the director's in between.
    echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_rb","name":"mcp__direction__direction_turnover_update","input":{"turnoverID":"t","readBack":[{"noteID":"n","plan":"Drop the second wide."}]}}]},"session_id":"'"$session"'"}'
    touch "$folder/.fake-asked"
    for _ in $(seq 400); do [ -f "$folder/.fake-go" ] && break; sleep 0.05; done
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_rb","content":[{"type":"text","text":"{}"}]}]},"session_id":"'"$session"'"}'
    echo '{"type":"result","subtype":"success","is_error":false,"result":"{\"finished\": false, \"summary\": \"Read back 1 note.\", \"needsYou\": [\"OK the read-back\"]}","total_cost_usd":0.05,"session_id":"'"$session"'"}'
    ;;
  readback-script)
    # The same read-back made inside a direction_run script: the stream shows only the script.
    echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"toolu_rs","name":"mcp__direction__direction_run","input":{"does":"Reading back the note","code":"return direction.turnover_update({turnoverID: \"t\", readBack: [{noteID: \"n\", plan: \"Drop the second wide.\"}]})"}}]},"session_id":"'"$session"'"}'
    touch "$folder/.fake-asked"
    for _ in $(seq 400); do [ -f "$folder/.fake-go" ] && break; sleep 0.05; done
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_rs","content":[{"type":"text","text":"{\"result\":{}}"}]}]},"session_id":"'"$session"'"}'
    echo '{"type":"result","subtype":"success","is_error":false,"result":"{\"finished\": false, \"summary\": \"Read back 1 note.\", \"needsYou\": [\"OK the read-back\"]}","total_cost_usd":0.05,"session_id":"'"$session"'"}'
    ;;
  running-total)
    # Like Claude Code: the session's running total, carried on by --resume and started over without it.
    read_notes
    total=25
    if printf '%s\n' "$@" | grep -qx -- "--resume"; then total=$(( $(cat "$folder/.fake-total" 2>/dev/null || echo 0) + 25 )); fi
    echo "$total" > "$folder/.fake-total"
    cost=$(awk "BEGIN { printf \"%.2f\", $total / 100 }")
    echo '{"type":"result","subtype":"success","is_error":false,"result":"{\"finished\": true, \"summary\": \"Logged 1 take.\", \"needsYou\": []}","total_cost_usd":'"$cost"',"session_id":"'"$session"'"}'
    ;;
  stubborn)
    # Ignores Ctrl-C and SIGTERM; only SIGKILL stops it.
    read_notes
    echo $$ > "$folder/.fake-pid"
    trap '' INT TERM
    while true; do sleep 0.2; done
    ;;
esac
